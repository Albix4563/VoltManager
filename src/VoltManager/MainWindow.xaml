<Window x:Class="VoltManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="VoltManager" Height="800" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/voltmanager.ico"
        Background="#0a1128">
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#0A1128" />
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="VoltManager"
                        IconSource="pack://application:,,,/Assets/voltmanager.ico"
                        Visibility="Visible"
                        TrayLeftMouseUp="TrayIcon_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Apri VoltManager" Click="TrayOpen_Click" FontWeight="Bold" />
                    <Separator />
                    <MenuItem Header="Esci" Click="TrayExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
