<Window x:Class="VoltManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="VoltManager" Height="800" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/voltmanager.ico"
        Background="#0a1128">
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#0A1128" />
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="VoltManager"
                        IconSource="pack://application:,,,/Assets/voltmanager.ico"
                        Visibility="Visible"
                        TrayLeftMouseUp="TrayIcon_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="TrayMenu_Opened">
                    <MenuItem x:Name="TrayOpenItem" Header="Apri VoltManager" Click="TrayOpen_Click" FontWeight="Bold" />
                    <Separator />
                    <MenuItem x:Name="TrayActivePlanItem" Header="Piano attivo: —" IsEnabled="False" />
                    <MenuItem x:Name="TrayGamingPlanItem" Header="Piano gaming" IsCheckable="True" Click="TrayGamingPlan_Click" />
                    <MenuItem x:Name="TrayChangePlanItem" Header="Cambia piano">
                        <MenuItem x:Name="TrayPlanSaverItem" Header="Risparmio energia">
                            <MenuItem x:Name="TrayPlanSaver1h" Header="1 ora" Tag="powerSaver|1" Click="TrayPlanDuration_Click" />
                            <MenuItem x:Name="TrayPlanSaver10h" Header="10 ore" Tag="powerSaver|10" Click="TrayPlanDuration_Click" />
                            <MenuItem x:Name="TrayPlanSaver12h" Header="12 ore" Tag="powerSaver|12" Click="TrayPlanDuration_Click" />
                            <MenuItem x:Name="TrayPlanSaverForever" Header="Sempre" Tag="powerSaver|0" Click="TrayPlanDuration_Click" />
                        </MenuItem>
                        <MenuItem x:Name="TrayPlanBalancedItem" Header="Bilanciato">
                            <MenuItem x:Name="TrayBalanced1h" Header="1 ora" Tag="balanced|1" Click="TrayPlanDuration_Click" />
                            <MenuItem x:Name="TrayBalanced10h" Header="10 ore" Tag="balanced|10" Click="TrayPlanDuration_Click" />
                            <MenuItem x:Name="TrayBalanced12h" Header="12 ore" Tag="balanced|12" Click="TrayPlanDuration_Click" />
                            <MenuItem x:Name="TrayBalancedForever" Header="Sempre" Tag="balanced|0" Click="TrayPlanDuration_Click" />
                        </MenuItem>
                        <MenuItem x:Name="TrayPlanPerfItem" Header="Prestazioni">
                            <MenuItem x:Name="TrayPerf1h" Header="1 ora" Tag="performance|1" Click="TrayPlanDuration_Click" />
                            <MenuItem x:Name="TrayPerf10h" Header="10 ore" Tag="performance|10" Click="TrayPlanDuration_Click" />
                            <MenuItem x:Name="TrayPerf12h" Header="12 ore" Tag="performance|12" Click="TrayPlanDuration_Click" />
                            <MenuItem x:Name="TrayPerfForever" Header="Sempre" Tag="performance|0" Click="TrayPlanDuration_Click" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem x:Name="TrayKeepAwakeItem" Header="Tieni PC attivo (no sospensione)"
                              IsCheckable="True" Click="TrayKeepAwake_Click" />
                    <MenuItem x:Name="TrayClearOverrideItem" Header="Sblocca piano (riprendi automazione)"
                              Visibility="Collapsed" Click="TrayClearOverride_Click" />
                    <MenuItem x:Name="TrayAutomationItem" Header="Automazione piano" IsCheckable="True"
                              Click="TrayAutomation_Click" />
                    <Separator />
                    <MenuItem x:Name="TraySchedulePowerItem" Header="Programma azione PC">
                        <MenuItem Header="30 minuti" Tag="30">
                            <MenuItem Header="Spegni" Tag="shutdown|30" Click="TraySchedulePreset_Click" />
                            <MenuItem Header="Sospendi" Tag="sleep|30" Click="TraySchedulePreset_Click" />
                        </MenuItem>
                        <MenuItem Header="45 minuti" Tag="45">
                            <MenuItem Header="Spegni" Tag="shutdown|45" Click="TraySchedulePreset_Click" />
                            <MenuItem Header="Sospendi" Tag="sleep|45" Click="TraySchedulePreset_Click" />
                        </MenuItem>
                        <MenuItem Header="1 ora">
                            <MenuItem Header="Spegni" Tag="shutdown|60" Click="TraySchedulePreset_Click" />
                            <MenuItem Header="Sospendi" Tag="sleep|60" Click="TraySchedulePreset_Click" />
                        </MenuItem>
                        <MenuItem Header="2 ore">
                            <MenuItem Header="Spegni" Tag="shutdown|120" Click="TraySchedulePreset_Click" />
                            <MenuItem Header="Sospendi" Tag="sleep|120" Click="TraySchedulePreset_Click" />
                        </MenuItem>
                        <MenuItem Header="4 ore">
                            <MenuItem Header="Spegni" Tag="shutdown|240" Click="TraySchedulePreset_Click" />
                            <MenuItem Header="Sospendi" Tag="sleep|240" Click="TraySchedulePreset_Click" />
                        </MenuItem>
                        <MenuItem x:Name="TrayScheduleCustomItem" Header="Tempo personalizzato..." Click="TrayScheduleCustom_Click" />
                    </MenuItem>
                    <MenuItem x:Name="TrayScheduledStateItem" Header="Nessuna azione programmata" IsEnabled="False" />
                    <MenuItem x:Name="TrayCancelScheduledItem" Header="Annulla azione programmata" Visibility="Collapsed" Click="TrayCancelScheduled_Click" />
                    <Separator />
                    <MenuItem x:Name="TrayExitItem" Header="Esci" Click="TrayExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
