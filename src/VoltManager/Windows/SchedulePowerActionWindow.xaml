<Window x:Class="VoltManager.SchedulePowerActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tempo personalizzato" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="20" Background="#0a1128">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tempo personalizzato" FontSize="18" FontWeight="Bold"
                   Foreground="#e0e0ff" Margin="0,0,0,16" />

        <!-- Durata -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="HoursLabel" Text="Ore" Foreground="#a0a0cc" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="HoursTextBox" Text="0" TextAlignment="Center" FontSize="16"
                         Background="#1a1a3e" Foreground="#e0e0ff"
                         BorderBrush="#404080" BorderThickness="1"
                         Padding="8,6" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="MinutesLabel" Text="Minuti" Foreground="#a0a0cc" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="MinutesTextBox" Text="30" TextAlignment="Center" FontSize="16"
                         Background="#1a1a3e" Foreground="#e0e0ff"
                         BorderBrush="#404080" BorderThickness="1"
                         Padding="8,6" />
            </StackPanel>
        </Grid>

        <!-- Azione -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock x:Name="ActionLabel" Text="Azione" Foreground="#a0a0cc" FontSize="12" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ShutdownRadio" IsChecked="True" GroupName="Action" Margin="0,0,16,0"
                             Foreground="#e0e0ff" FontSize="14">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ShutdownText" Text="Spegni" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
                <RadioButton x:Name="SleepRadio" GroupName="Action"
                             Foreground="#e0e0ff" FontSize="14">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SleepText" Text="Sospendi" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
            </StackPanel>
        </StackPanel>

        <!-- Riepilogo -->
        <Border Grid.Row="3" Background="#1a1a3e" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="SummaryLabel" Text="Il PC verrà spento alle --:--"
                           Foreground="#e0e0ff" FontSize="14" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorLabel" Foreground="#ff6b6b" FontSize="12"
                           Visibility="Collapsed" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Pulsanti -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Annulla" Width="100" Height="36"
                    Click="CancelButton_Click"
                    Background="#2a2a4e" Foreground="#e0e0ff"
                    BorderBrush="#404080" BorderThickness="1"
                    Margin="0,0,12,0" />
            <Button x:Name="ConfirmButton" Content="Conferma" Width="100" Height="36"
                    Click="ConfirmButton_Click"
                    Background="#5050cc" Foreground="White"
                    BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
