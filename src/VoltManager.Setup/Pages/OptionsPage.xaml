<UserControl x:Class="VoltManager.Setup.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageEntrance}" Margin="0,4,8,4">
            <Grid.RenderTransform><TranslateTransform Y="12"/></Grid.RenderTransform>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0,0,0,18"/>

                <TextBlock x:Name="LabelFolder" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,8"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtDir" MinHeight="42" Height="42" Margin="0,0,10,0" FontFamily="Consolas" FontSize="11.5"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Button Grid.Column="1" x:Name="BtnBrowse" Style="{StaticResource GhostBtn}" Height="42"
                            Padding="16,0" Click="BtnBrowse_Click"/>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="16,2">
                    <StackPanel>
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Monitor}" Stroke="{StaticResource TextMutedBrush}"
                                  Width="17" Height="17" VerticalAlignment="Top" Margin="0,9,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <CheckBox x:Name="ChkDesktop" Style="{StaticResource OptionSwitch}"/>
                                <TextBlock x:Name="DescDesktop" FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,1,48,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#263550"/>

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Power}" Stroke="{StaticResource TextMutedBrush}"
                                  Width="17" Height="17" VerticalAlignment="Top" Margin="0,9,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <CheckBox x:Name="ChkStartup" Style="{StaticResource OptionSwitch}"/>
                                <TextBlock x:Name="DescStartup" FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,1,48,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#263550"/>

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Widgets}" Stroke="{StaticResource TextMutedBrush}"
                                  Width="17" Height="17" VerticalAlignment="Top" Margin="0,9,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <CheckBox x:Name="ChkWidgets" Style="{StaticResource OptionSwitch}"
                                          Checked="ChkWidgets_Changed" Unchecked="ChkWidgets_Changed"/>
                                <TextBlock x:Name="DescWidgets" FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,1,48,0"/>
                                <Border x:Name="WidgetPicker" Visibility="Collapsed" Margin="0,9,0,1" Padding="12,10"
                                        Background="#0D1A30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock x:Name="LblWidgetPick" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <CheckBox x:Name="ChkWClock" Margin="0,0,14,8"/>
                                            <CheckBox x:Name="ChkWCalendar" Margin="0,0,14,8"/>
                                            <CheckBox x:Name="ChkWUsage" Margin="0,0,14,8"/>
                                            <CheckBox x:Name="ChkWTemps" Margin="0,0,14,8"/>
                                            <CheckBox x:Name="ChkWPower" Margin="0,0,14,8"/>
                                            <CheckBox x:Name="ChkWPlans" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#263550"/>

                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Play}" Stroke="{StaticResource TextMutedBrush}"
                                  Width="17" Height="17" VerticalAlignment="Top" Margin="0,9,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <CheckBox x:Name="ChkLaunch" Style="{StaticResource OptionSwitch}"/>
                                <TextBlock x:Name="DescLaunch" FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,1,48,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
