<UserControl x:Class="VoltManager.Setup.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,16,0,0" Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform>
            <TranslateTransform Y="22"/>
        </StackPanel.RenderTransform>

        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20"/>

        <!-- Install folder -->
        <TextBlock x:Name="LabelFolder" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtDir" Margin="0,0,8,0"
                     FontSize="12" Padding="10,8"/>
            <Button Grid.Column="1" x:Name="BtnBrowse" Style="{StaticResource GhostBtn}"
                    Padding="14,8" FontSize="12" Click="BtnBrowse_Click"/>
        </Grid>

        <!-- Checkboxes -->
        <Border Style="{StaticResource Card}" Padding="16,14">
            <StackPanel>
                <CheckBox x:Name="ChkDesktop"  Margin="0,0,0,14"/>
                <CheckBox x:Name="ChkStartup"  Margin="0,0,0,14"/>
                <CheckBox x:Name="ChkLaunch"   Margin="0,0,0,0"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
