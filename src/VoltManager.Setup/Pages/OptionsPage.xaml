<UserControl x:Class="VoltManager.Setup.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform><TranslateTransform Y="30"/></StackPanel.RenderTransform>

        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0,0,0,24"/>

        <!-- Install folder -->
        <TextBlock x:Name="LabelFolder" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,10"/>
        <Grid Margin="0,0,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                    Background="#1800F1FE" Margin="0,0,12,0">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}"
                      Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBox Grid.Column="1" x:Name="TxtDir" Margin="0,0,12,0" FontSize="12.5"
                     MinHeight="44" Height="44" VerticalContentAlignment="Center"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Button Grid.Column="2" x:Name="BtnBrowse" Style="{StaticResource GhostBtn}"
                    Padding="20,0" Height="44" FontSize="12.5" Click="BtnBrowse_Click"/>
        </Grid>

        <!-- Options card -->
        <Border Style="{StaticResource Card}" Padding="4,2">
            <StackPanel>
                <!-- Desktop shortcut -->
                <Grid Margin="18,16,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Monitor}"
                          Stroke="{StaticResource TextMutedBrush}" Width="20" Height="20"
                          VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkDesktop"/>
                        <TextBlock x:Name="DescDesktop" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                   TextWrapping="Wrap" Margin="36,4,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1A2742" Margin="18,0"/>
                <!-- Start with Windows -->
                <Grid Margin="18,16,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Power}"
                          Stroke="{StaticResource TextMutedBrush}" Width="20" Height="20"
                          VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkStartup"/>
                        <TextBlock x:Name="DescStartup" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                   TextWrapping="Wrap" Margin="36,4,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1A2742" Margin="18,0"/>
                <!-- Widgets -->
                <Grid Margin="18,16,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Widgets}"
                          Stroke="{StaticResource TextMutedBrush}" Width="20" Height="20"
                          VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkWidgets" Checked="ChkWidgets_Changed" Unchecked="ChkWidgets_Changed"/>
                        <TextBlock x:Name="DescWidgets" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                   TextWrapping="Wrap" Margin="36,4,0,0"/>
                        <Border x:Name="WidgetPicker" Visibility="Collapsed"
                                Margin="36,12,0,0" Padding="16,14"
                                Background="#0D1A30" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <TextBlock x:Name="LblWidgetPick" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkWClock" Margin="0,0,16,10"/>
                                    <CheckBox x:Name="ChkWCalendar" Margin="0,0,16,10"/>
                                    <CheckBox x:Name="ChkWUsage" Margin="0,0,16,10"/>
                                    <CheckBox x:Name="ChkWTemps" Margin="0,0,16,10"/>
                                    <CheckBox x:Name="ChkWPower" Margin="0,0,16,10"/>
                                    <CheckBox x:Name="ChkWPlans" Margin="0,0,0,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1A2742" Margin="18,0"/>
                <!-- Launch after install -->
                <Grid Margin="18,16,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Play}"
                          Stroke="{StaticResource TextMutedBrush}" Width="20" Height="20"
                          VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkLaunch"/>
                        <TextBlock x:Name="DescLaunch" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                   TextWrapping="Wrap" Margin="36,4,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>