<UserControl x:Class="VoltManager.Setup.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform>
            <TranslateTransform Y="24"/>
        </StackPanel.RenderTransform>

        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextStrongBrush}" Margin="0,0,0,20"/>

        <!-- Install folder -->
        <TextBlock x:Name="LabelFolder" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,8"/>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10"
                    Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}"
                      Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBox Grid.Column="1" x:Name="TxtDir" Margin="0,0,10,0" FontSize="12.5" Height="42"/>
            <Button Grid.Column="2" x:Name="BtnBrowse" Style="{StaticResource GhostBtn}"
                    Padding="18,0" Height="42" FontSize="12.5" Click="BtnBrowse_Click"/>
        </Grid>

        <!-- Options -->
        <Border Style="{StaticResource Card}" Padding="4,2">
            <StackPanel>
                <!-- desktop -->
                <Grid Margin="16,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Monitor}"
                          Stroke="{DynamicResource MutedBrush}" Width="19" Height="19"
                          VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkDesktop"/>
                        <TextBlock x:Name="DescDesktop" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                                   TextWrapping="Wrap" Margin="34,3,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1F2E4D" Margin="16,0"/>
                <!-- startup -->
                <Grid Margin="16,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Power}"
                          Stroke="{DynamicResource MutedBrush}" Width="19" Height="19"
                          VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkStartup"/>
                        <TextBlock x:Name="DescStartup" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                                   TextWrapping="Wrap" Margin="34,3,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1F2E4D" Margin="16,0"/>
                <!-- widgets -->
                <Grid Margin="16,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Widgets}"
                          Stroke="{DynamicResource MutedBrush}" Width="19" Height="19"
                          VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkWidgets" Checked="ChkWidgets_Changed" Unchecked="ChkWidgets_Changed"/>
                        <TextBlock x:Name="DescWidgets" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                                   TextWrapping="Wrap" Margin="34,3,0,0"/>
                        <!-- sub-picker: visibile solo se ChkWidgets è checked -->
                        <Border x:Name="WidgetPicker" Visibility="Collapsed"
                                Margin="34,10,0,0" Padding="12,10"
                                Background="{DynamicResource PillBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="LblWidgetPick" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ChkWClock"    IsChecked="True" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="ChkWCalendar" IsChecked="True" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="ChkWUsage"    IsChecked="True" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="ChkWTemps"    IsChecked="True" Margin="0,0,18,6"/>
                                    <CheckBox x:Name="ChkWPower"    IsChecked="True" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1F2E4D" Margin="16,0"/>
                <!-- launch -->
                <Grid Margin="16,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Play}"
                          Stroke="{DynamicResource MutedBrush}" Width="19" Height="19"
                          VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="ChkLaunch"/>
                        <TextBlock x:Name="DescLaunch" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                                   TextWrapping="Wrap" Margin="34,3,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
