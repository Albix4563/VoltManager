<UserControl x:Class="VoltManager.Setup.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,16,0,0" Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform>
            <TranslateTransform Y="22"/>
        </StackPanel.RenderTransform>

        <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,22"/>

        <!-- Install folder -->
        <TextBlock x:Name="LabelFolder" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtDir" Margin="0,0,8,0"
                     FontSize="12" Padding="10,8"/>
            <Button Grid.Column="1" x:Name="BtnBrowse" Style="{StaticResource GhostBtn}"
                    Padding="14,8" FontSize="12" Click="BtnBrowse_Click"/>
        </Grid>

        <!-- Options -->
        <Border Style="{StaticResource Card}" Padding="18,8">
            <StackPanel>
                <Grid Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Monitor}"
                          Stroke="{DynamicResource MutedBrush}" Width="18" Height="18"
                          VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox Grid.Column="1" x:Name="ChkDesktop" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="#243355" Opacity="0.6"/>
                <Grid Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Power}"
                          Stroke="{DynamicResource MutedBrush}" Width="18" Height="18"
                          VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox Grid.Column="1" x:Name="ChkStartup" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="#243355" Opacity="0.6"/>
                <Grid Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource Icon}" Data="{StaticResource Icon.Play}"
                          Stroke="{DynamicResource MutedBrush}" Width="18" Height="18"
                          VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox Grid.Column="1" x:Name="ChkLaunch" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
