<UserControl x:Class="VoltManager.Setup.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageEntrance}" HorizontalAlignment="Stretch">
        <StackPanel.RenderTransform>
            <TranslateTransform Y="24"/>
        </StackPanel.RenderTransform>

        <!-- Pulsing icon ring -->
        <Grid Width="88" Height="88" HorizontalAlignment="Center" Margin="0,0,0,22">
            <Ellipse Width="88" Height="88" Fill="{DynamicResource GlowBlobBrush}"/>
            <Ellipse Width="74" Height="74" Fill="#13213D" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#00F1FE" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleX"
                                                 From="0.94" To="1.06" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RingScale" Storyboard.TargetProperty="ScaleY"
                                                 From="0.94" To="1.06" Duration="0:0:1.1">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Path x:Name="PulseIcon" Style="{StaticResource Icon}" Data="{StaticResource Icon.Bolt}"
                  Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold"
                   Foreground="{DynamicResource TextStrongBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center"/>

        <TextBlock x:Name="WaitText" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,7,0,30"/>

        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0"
                     Height="10" Margin="6,0,6,14"/>

        <Grid Margin="6,0">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
            <Border HorizontalAlignment="Right" Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="7" Padding="10,3">
                <TextBlock x:Name="PctText" FontSize="12.5" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
