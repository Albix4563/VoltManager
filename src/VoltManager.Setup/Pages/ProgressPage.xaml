<UserControl x:Class="VoltManager.Setup.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageEntrance}" VerticalAlignment="Center">
        <Grid.RenderTransform><TranslateTransform Y="12"/></Grid.RenderTransform>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0,0,0,8"/>
            <TextBlock x:Name="WaitText" Style="{StaticResource Body}" Margin="0,0,0,22"/>

            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Top"
                                   FontSize="14.5" LineHeight="22" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PctText" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top"
                                   FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
