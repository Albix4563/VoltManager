<UserControl x:Class="VoltManager.Setup.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageEntrance}" VerticalAlignment="Center">
        <Grid.RenderTransform><TranslateTransform Y="12"/></Grid.RenderTransform>
        <StackPanel>
            <Border Width="58" Height="58" CornerRadius="29" Background="#14233E"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,18">
                <Path x:Name="PulseIcon" Style="{StaticResource Icon}" Data="{StaticResource Icon.Download}"
                      Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock x:Name="WaitText" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,6,0,26"/>

            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                        <TextBlock x:Name="PctText" HorizontalAlignment="Right" FontFamily="Consolas"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
