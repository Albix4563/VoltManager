<UserControl x:Class="VoltManager.Setup.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,24,0,0">

        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"
                   Foreground="#e2e8f0" Margin="0,0,0,8"/>

        <TextBlock x:Name="WaitText" FontSize="12" Foreground="#94a3b8" Margin="0,0,0,28"/>

        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0"
                     Height="6" Margin="0,0,0,12"/>

        <Grid>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#94a3b8"
                       HorizontalAlignment="Left"/>
            <TextBlock x:Name="PctText" FontSize="12" Foreground="#00f1fe"
                       HorizontalAlignment="Right"/>
        </Grid>

    </StackPanel>
</UserControl>
