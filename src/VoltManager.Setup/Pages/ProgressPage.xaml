<UserControl x:Class="VoltManager.Setup.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageEntrance}" HorizontalAlignment="Stretch">
        <StackPanel.RenderTransform><TranslateTransform Y="30"/></StackPanel.RenderTransform>

        <!-- Animated icon -->
        <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,26">
            <Ellipse Width="96" Height="96" Fill="{DynamicResource GlowBlobBrush}" Opacity="0.8"/>
            <Ellipse Width="80" Height="80" Fill="{StaticResource SurfaceBrush}"
                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Effect>
                    <DropShadowEffect Color="{DynamicResource C.Accent}" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="RingScale" ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="RingScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="0.94" To="1.06" Duration="0:0:1.2">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RingScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="0.94" To="1.06" Duration="0:0:1.2">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Path x:Name="PulseIcon" Style="{StaticResource Icon}" Data="{StaticResource Icon.Download}"
                  Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock x:Name="WaitText" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                   TextAlignment="Center" Margin="0,8,0,34"/>

        <!-- Progress bar -->
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0" Margin="8,0,8,16"/>

        <!-- Status row -->
        <Grid Margin="8,0">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="340"/>
            <Border HorizontalAlignment="Right" Background="#1800F1FE" CornerRadius="8" Padding="12,4">
                <TextBlock x:Name="PctText" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>