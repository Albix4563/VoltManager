<UserControl x:Class="VoltManager.Setup.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,16,0,0">

        <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock x:Name="SubtitleText" FontSize="13" LineHeight="22"
                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,24"/>

        <!-- Info card -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ℹ" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="InfoText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Requirement pills -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" FlowDirection="LeftToRight">
            <Border Background="{DynamicResource PillBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Windows 10/11 x64" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource PillBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="WebView2 Runtime" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource PillBrush}" CornerRadius="6" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Admin privileges" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>
