<UserControl x:Class="VoltManager.Setup.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform>
            <TranslateTransform Y="24"/>
        </StackPanel.RenderTransform>

        <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,10"/>

        <TextBlock x:Name="SubtitleText" Style="{StaticResource Body}" Margin="0,0,0,22"/>

        <!-- Feature highlights -->
        <Border Style="{StaticResource Card}" Padding="6,4">
            <StackPanel>
                <!-- row 1 -->
                <Grid Margin="14,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11"
                            Background="{DynamicResource AccentSoftBrush}" Margin="0,0,15,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Gauge}"
                              Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Feat1Title" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextStrongBrush}"/>
                        <TextBlock x:Name="Feat1Desc" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1F2E4D" Margin="14,0"/>
                <!-- row 2 -->
                <Grid Margin="14,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11"
                            Background="{DynamicResource AccentSoftBrush}" Margin="0,0,15,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Leaf}"
                              Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Feat2Title" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextStrongBrush}"/>
                        <TextBlock x:Name="Feat2Desc" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1F2E4D" Margin="14,0"/>
                <!-- row 3 -->
                <Grid Margin="14,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11"
                            Background="{DynamicResource AccentSoftBrush}" Margin="0,0,15,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Bolt}"
                              Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Feat3Title" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextStrongBrush}"/>
                        <TextBlock x:Name="Feat3Desc" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Info hint -->
        <StackPanel Orientation="Horizontal" Margin="2,18,0,0">
            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Info}"
                  Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock x:Name="InfoText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Requirement pills -->
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Border Background="{DynamicResource PillBrush}" CornerRadius="8" Padding="12,7" Margin="0,0,9,0"
                    BorderBrush="#1F2E4D" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource SuccessBrush}"
                          Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Windows 10/11 x64" Foreground="{DynamicResource TextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource PillBrush}" CornerRadius="8" Padding="12,7" Margin="0,0,9,0"
                    BorderBrush="#1F2E4D" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Check}" Stroke="{DynamicResource SuccessBrush}"
                          Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="WebView2 Runtime" Foreground="{DynamicResource TextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource PillBrush}" CornerRadius="8" Padding="12,7"
                    BorderBrush="#1F2E4D" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Shield}" Stroke="{DynamicResource SuccessBrush}"
                          Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Admin" Foreground="{DynamicResource TextBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>
