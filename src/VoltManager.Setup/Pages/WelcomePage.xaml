<UserControl x:Class="VoltManager.Setup.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageEntrance}" VerticalAlignment="Center">
        <Grid.RenderTransform><TranslateTransform Y="12"/></Grid.RenderTransform>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,8"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Body}" Margin="0,0,0,22" MaxWidth="500" HorizontalAlignment="Left"/>

            <Border Style="{StaticResource Card}" Padding="16,4">
                <StackPanel>
                    <Grid Margin="0,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="7" Background="#14233E" VerticalAlignment="Top">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Gauge}" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="Feat1Title" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="Feat1Desc" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="#263550"/>
                    <Grid Margin="0,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="7" Background="#14233E" VerticalAlignment="Top">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Leaf}" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="Feat2Title" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="Feat2Desc" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="#263550"/>
                    <Grid Margin="0,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="7" Background="#14233E" VerticalAlignment="Top">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Bolt}" Width="16" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="Feat3Title" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="Feat3Desc" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="2,14,0,0">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Info}" Width="14" Height="14"
                      Stroke="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,2,9,0"/>
                <TextBlock x:Name="InfoText" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" MaxWidth="470"/>
            </StackPanel>

            <Border Background="#0B1429" BorderBrush="#263550" BorderThickness="1" CornerRadius="8"
                    Padding="14,10" Margin="0,14,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Windows 10/11 x64" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="WebView2 Runtime" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Admin" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>
                </WrapPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
