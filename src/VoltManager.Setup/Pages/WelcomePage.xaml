<UserControl x:Class="VoltManager.Setup.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform><TranslateTransform Y="30"/></StackPanel.RenderTransform>

        <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Margin="0,0,0,10"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Body}" Margin="0,0,0,26"/>

        <!-- Feature cards -->
        <Border Style="{StaticResource Card}" Padding="6,4">
            <StackPanel>
                <!-- Feature 1 -->
                <Grid Margin="16,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                            Background="#1800F1FE" Margin="0,0,16,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Gauge}"
                              Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Feat1Title" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="Feat1Desc" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1A2742" Margin="16,0"/>
                <!-- Feature 2 -->
                <Grid Margin="16,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                            Background="#1800F1FE" Margin="0,0,16,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Leaf}"
                              Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Feat2Title" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="Feat2Desc" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#1A2742" Margin="16,0"/>
                <!-- Feature 3 -->
                <Grid Margin="16,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                            Background="#1800F1FE" Margin="0,0,16,0">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Bolt}"
                              Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Feat3Title" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="Feat3Desc" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Info hint -->
        <StackPanel Orientation="Horizontal" Margin="2,20,0,0">
            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Info}"
                  Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,10,0"
                  Stroke="{StaticResource TextMutedBrush}"/>
            <TextBlock x:Name="InfoText" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Requirement pills -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Check}"
                          Stroke="{StaticResource SuccessBrush}" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Windows 10/11 x64" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,8" Margin="0,0,10,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Check}"
                          Stroke="{StaticResource SuccessBrush}" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="WebView2 Runtime" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="14,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Shield}"
                          Stroke="{StaticResource SuccessBrush}" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Admin" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>