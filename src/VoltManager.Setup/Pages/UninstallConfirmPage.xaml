<UserControl x:Class="VoltManager.Setup.Pages.UninstallConfirmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageEntrance}" VerticalAlignment="Center">
        <Grid.RenderTransform><TranslateTransform Y="12"/></Grid.RenderTransform>
        <StackPanel>
            <Border Width="62" Height="62" CornerRadius="31" Background="#211316"
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}" Stroke="{StaticResource DangerBrush}"
                      Width="27" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,0,0,7"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Body}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,0,0,18" MaxWidth="420"/>

            <Border Style="{StaticResource Card}" Padding="16,12" MaxWidth="450" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}" Stroke="{StaticResource TextMutedBrush}"
                              Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="Item1" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}" Stroke="{StaticResource TextMutedBrush}"
                              Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="Item2" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Power}" Stroke="{StaticResource TextMutedBrush}"
                              Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="Item3" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#1A1508" BorderBrush="#5A3F1F" BorderThickness="1" CornerRadius="8"
                    Padding="14,10" MaxWidth="450" HorizontalAlignment="Center" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Warning}" Stroke="{StaticResource WarningBrush}"
                          Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,10,0"/>
                    <TextBlock x:Name="WarnText" FontSize="11.5" Foreground="#F2D9A8"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="375" LineHeight="18"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
