<UserControl x:Class="VoltManager.Setup.Pages.UninstallConfirmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform><TranslateTransform Y="30"/></StackPanel.RenderTransform>

        <!-- Danger icon -->
        <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,22"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IconScale" ScaleX="0.5" ScaleY="0.5"/>
            </Grid.RenderTransform>
            <Ellipse Width="104" Height="104" Fill="{StaticResource GlowBlobDangerBrush}"/>
            <Ellipse Width="84" Height="84" Fill="#1A1015"
                     Stroke="{StaticResource DangerBrush}" StrokeThickness="1.8" Opacity="0.95">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF5B4A" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
                </Ellipse.Effect>
            </Ellipse>
            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}"
                  Stroke="{StaticResource DangerBrush}" Width="38" Height="38"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                             From="0.5" To="1" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                             From="0.5" To="1" Duration="0:0:0.55">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" HorizontalAlignment="Center"
                   TextAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock x:Name="SubText" Style="{StaticResource Body}" HorizontalAlignment="Center"
                   TextAlignment="Center" Margin="0,0,0,22" MaxWidth="400"/>

        <!-- What will be removed -->
        <Border Style="{StaticResource Card}" Padding="20,16" MaxWidth="440" HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}"
                          Stroke="{StaticResource DangerBrush}" Width="13" Height="13"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="Item1" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}"
                          Stroke="{StaticResource DangerBrush}" Width="13" Height="13"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="Item2" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Power}"
                          Stroke="{StaticResource WarningBrush}" Width="13" Height="13"
                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="Item3" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Warning -->
        <Border Background="#1A1508" BorderBrush="#5A3F1F" BorderThickness="1" CornerRadius="12"
                Padding="16,12" MaxWidth="440" HorizontalAlignment="Center" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Warning}"
                      Stroke="{StaticResource WarningBrush}" Width="17" Height="17"
                      VerticalAlignment="Top" Margin="0,1,12,0"/>
                <TextBlock x:Name="WarnText" FontSize="12" Foreground="#F2D9A8"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="350" LineHeight="19"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>