<UserControl x:Class="VoltManager.Setup.Pages.UninstallConfirmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,20,0,0" Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform>
            <TranslateTransform Y="22"/>
        </StackPanel.RenderTransform>

        <!-- Trash icon in danger-tinted ring -->
        <Grid Width="86" Height="86" HorizontalAlignment="Center" Margin="0,0,0,18"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IconScale" ScaleX="0.6" ScaleY="0.6"/>
            </Grid.RenderTransform>
            <Ellipse Width="72" Height="72" Fill="#1E1620" Stroke="{DynamicResource DangerBrush}"
                     StrokeThickness="1.4" Opacity="0.95">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#E74C3C" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
                </Ellipse.Effect>
            </Ellipse>
            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}"
                  Stroke="{DynamicResource DangerBrush}" Width="34" Height="34"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                             From="0.6" To="1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                             From="0.6" To="1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

        <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock x:Name="SubText" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,0,0,22" MaxWidth="340"/>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="15,12" MaxWidth="380">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Warning}"
                      Stroke="{DynamicResource WarningBrush}" Width="17" Height="17"
                      VerticalAlignment="Center" Margin="0,0,11,0"/>
                <TextBlock x:Name="WarnText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="310"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
