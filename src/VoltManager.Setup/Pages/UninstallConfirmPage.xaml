<UserControl x:Class="VoltManager.Setup.Pages.UninstallConfirmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform>
            <TranslateTransform Y="24"/>
        </StackPanel.RenderTransform>

        <!-- Trash icon in danger-tinted ring -->
        <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,18"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IconScale" ScaleX="0.6" ScaleY="0.6"/>
            </Grid.RenderTransform>
            <Ellipse Width="96" Height="96" Fill="{DynamicResource DangerGlobBrush}"/>
            <Ellipse Width="78" Height="78" Fill="#1E1620" Stroke="{DynamicResource DangerBrush}"
                     StrokeThickness="1.6" Opacity="0.95">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF5B4A" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/>
                </Ellipse.Effect>
            </Ellipse>
            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}"
                  Stroke="{DynamicResource DangerBrush}" Width="36" Height="36"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                             From="0.6" To="1" Duration="0:0:0.52">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                             From="0.6" To="1" Duration="0:0:0.52">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center"
                   TextAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock x:Name="SubText" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,0,0,18" MaxWidth="380"/>

        <!-- What will be removed -->
        <Border Style="{StaticResource Card}" Padding="18,14" MaxWidth="420" HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource DangerBrush}"
                          Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock x:Name="Item1" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource DangerBrush}"
                          Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock x:Name="Item2" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Power}" Stroke="{DynamicResource WarningBrush}"
                          Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock x:Name="Item3" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Irreversible warning -->
        <Border Background="#2A1E12" BorderBrush="#5A3F1F" BorderThickness="1" CornerRadius="10"
                Padding="14,11" MaxWidth="420" HorizontalAlignment="Center" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Warning}"
                      Stroke="{DynamicResource WarningBrush}" Width="17" Height="17"
                      VerticalAlignment="Top" Margin="0,1,11,0"/>
                <TextBlock x:Name="WarnText" FontSize="12" Foreground="#F2D9A8"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="340" LineHeight="19"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
