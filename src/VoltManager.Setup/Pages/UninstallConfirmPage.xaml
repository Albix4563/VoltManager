<UserControl x:Class="VoltManager.Setup.Pages.UninstallConfirmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,24,0,0" Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform>
            <TranslateTransform Y="22"/>
        </StackPanel.RenderTransform>

        <TextBlock FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,16"
                   Text="🗑" Foreground="{DynamicResource DangerBrush}"/>

        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock x:Name="SubText" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,0,0,20"/>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="{DynamicResource WarningBrush}" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="WarnText" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
