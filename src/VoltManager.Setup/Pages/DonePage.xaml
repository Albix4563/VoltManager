<UserControl x:Class="VoltManager.Setup.Pages.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageEntrance}" VerticalAlignment="Center">
        <Grid.RenderTransform><TranslateTransform Y="12"/></Grid.RenderTransform>
        <StackPanel>
            <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Ellipse x:Name="Ring" Width="56" Height="56" Fill="{StaticResource SurfaceBrush}"
                         Stroke="{StaticResource SuccessBrush}" StrokeThickness="1.5"/>
                <Path x:Name="IconPath" Style="{StaticResource Icon}" Width="28" Height="28" StrokeThickness="2.1"
                      Stroke="{StaticResource SuccessBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="SubText" Style="{StaticResource Body}" HorizontalAlignment="Center"
                       TextAlignment="Center" Margin="0,0,0,18" MaxWidth="440"/>

            <Border x:Name="ErrCard" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,11" MaxWidth="440" Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Warning}"
                          Stroke="{StaticResource DangerBrush}" Width="15" Height="15"
                          VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock x:Name="ErrText" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" MaxWidth="370"/>
                </StackPanel>
            </Border>

            <Border x:Name="LaunchPill" Style="{StaticResource Card}" Padding="14,10"
                    HorizontalAlignment="Center" Visibility="Collapsed">
                <CheckBox x:Name="ChkLaunch"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
