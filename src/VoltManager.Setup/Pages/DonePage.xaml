<UserControl x:Class="VoltManager.Setup.Pages.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource PageEntrance}">
        <StackPanel.RenderTransform>
            <TranslateTransform Y="24"/>
        </StackPanel.RenderTransform>

        <!-- Icon in glowing ring (pop-in) -->
        <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,20"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IconScale" ScaleX="0.5" ScaleY="0.5"/>
            </Grid.RenderTransform>
            <Ellipse Width="104" Height="104" Fill="{DynamicResource GlowBlobBrush}"/>
            <Ellipse x:Name="Ring" Width="84" Height="84" Fill="#13213D" Stroke="{DynamicResource AccentBrush}"
                     StrokeThickness="1.6">
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="RingGlow" Color="{DynamicResource C.Accent}" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
                </Ellipse.Effect>
            </Ellipse>
            <Path x:Name="IconPath" Style="{StaticResource Icon}" Width="42" Height="42"
                  StrokeThickness="2.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                             From="0.5" To="1" Duration="0:0:0.58">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                             From="0.5" To="1" Duration="0:0:0.58">
                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center"
                   TextAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock x:Name="SubText" FontSize="13.5" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,0,0,20" MaxWidth="400" LineHeight="22"/>

        <!-- Error detail card -->
        <Border x:Name="ErrCard" Background="#231521" BorderBrush="#5A2A2A" BorderThickness="1"
                CornerRadius="10" Padding="14,11" MaxWidth="420" Margin="0,0,0,12"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Warning}" Stroke="{DynamicResource DangerBrush}"
                      Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,11,0"/>
                <TextBlock x:Name="ErrText" FontSize="11.5" Foreground="#FFB4AC"
                           TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </Border>

        <!-- Launch toggle in a pill -->
        <Border x:Name="LaunchPill" Background="{DynamicResource PillBrush}" BorderBrush="#1F2E4D" BorderThickness="1"
                CornerRadius="10" Padding="16,11" HorizontalAlignment="Center" Margin="0,4,0,0"
                Visibility="Collapsed">
            <CheckBox x:Name="ChkLaunch"/>
        </Border>

    </StackPanel>
</UserControl>
