<UserControl x:Class="VoltManager.Setup.Pages.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,24,0,0">

        <!-- Icon -->
        <TextBlock x:Name="IconText" FontSize="40" HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>

        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock x:Name="SubText" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                   HorizontalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="0,0,0,24"/>

        <TextBlock x:Name="ErrText" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

        <CheckBox x:Name="ChkLaunch" HorizontalAlignment="Center" Visibility="Collapsed"/>

    </StackPanel>
</UserControl>
