<Application x:Class="VoltManager.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ═══════════════════════════════════════════════════════════════
             PALETTE — superfici condivise e colore tema dinamico
             ═══════════════════════════════════════════════════════════════ -->
        <Color x:Key="C.Bg.Deep">#040810</Color>
        <Color x:Key="C.Bg.Base">#0A1128</Color>
        <Color x:Key="C.Bg.Elevated">#0F1A36</Color>
        <Color x:Key="C.Surface">#16233F</Color>
        <Color x:Key="C.Surface.High">#1C2B4A</Color>
        <Color x:Key="C.Surface.Glass">#1A2744</Color>
        <Color x:Key="C.Accent">#3B82F6</Color>
        <Color x:Key="C.Accent.Dim">#60A5FA</Color>
        <Color x:Key="C.Accent.Glow">#93C5FD</Color>
        <Color x:Key="C.Accent.Deep">#2563EB</Color>
        <Color x:Key="C.Accent.Alpha40">#403B82F6</Color>
        <Color x:Key="C.Accent.Alpha20">#203B82F6</Color>
        <Color x:Key="C.Accent.Transparent">#003B82F6</Color>
        <Color x:Key="C.Text.Primary">#F8FAFC</Color>
        <Color x:Key="C.Text.Secondary">#CBD5E1</Color>
        <Color x:Key="C.Text.Muted">#94A3B8</Color>
        <Color x:Key="C.Text.Faint">#64748B</Color>
        <Color x:Key="C.Border">#334155</Color>
        <Color x:Key="C.Border.Light">#475569</Color>
        <Color x:Key="C.Danger">#FF5B4A</Color>
        <Color x:Key="C.Danger.Dim">#C44438</Color>
        <Color x:Key="C.Warning">#F5B042</Color>
        <Color x:Key="C.Success">#34E0A1</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource C.Bg.Deep}"/>
        <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource C.Bg.Base}"/>
        <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource C.Bg.Elevated}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource C.Surface}"/>
        <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource C.Surface.High}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource C.Accent}"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="{DynamicResource C.Accent.Dim}"/>
        <SolidColorBrush x:Key="AccentGlowBrush" Color="{DynamicResource C.Accent.Glow}"/>
        <SolidColorBrush x:Key="AccentDeepBrush" Color="{DynamicResource C.Accent.Deep}"/>
        <SolidColorBrush x:Key="AccentSelectionBrush" Color="{DynamicResource C.Accent.Alpha40}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource C.Text.Primary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource C.Text.Secondary}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource C.Text.Muted}"/>
        <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource C.Text.Faint}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource C.Border}"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource C.Border.Light}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource C.Danger}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource C.Warning}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource C.Success}"/>

        <!-- ═══════════════════════════════════════════════════════════════
             GRADIENTS
             ═══════════════════════════════════════════════════════════════ -->
        <LinearGradientBrush x:Key="WindowBgGradient" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#060D1F" Offset="0"/>
            <GradientStop Color="#0A1128" Offset="0.4"/>
            <GradientStop Color="#0D1530" Offset="0.7"/>
            <GradientStop Color="#040810" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0.15,1">
            <GradientStop Color="#0C1630" Offset="0"/>
            <GradientStop Color="#081020" Offset="0.5"/>
            <GradientStop Color="#050A18" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{DynamicResource C.Accent.Glow}" Offset="0"/>
            <GradientStop Color="{DynamicResource C.Accent}" Offset="0.45"/>
            <GradientStop Color="{DynamicResource C.Accent.Deep}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradientVertical" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource C.Accent.Glow}" Offset="0"/>
            <GradientStop Color="{DynamicResource C.Accent}" Offset="0.5"/>
            <GradientStop Color="{DynamicResource C.Accent.Deep}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF7B6A" Offset="0"/>
            <GradientStop Color="#FF5B4A" Offset="0.5"/>
            <GradientStop Color="#E7432F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E2D4E" Offset="0"/>
            <GradientStop Color="#16233F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardStrokeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3E5278" Offset="0"/>
            <GradientStop Color="#243355" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressTrackGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0D1A30" Offset="0"/>
            <GradientStop Color="#122240" Offset="0.5"/>
            <GradientStop Color="#0D1A30" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressFillGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{DynamicResource C.Accent.Deep}" Offset="0"/>
            <GradientStop Color="{DynamicResource C.Accent}" Offset="0.5"/>
            <GradientStop Color="{DynamicResource C.Accent.Glow}" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="GlowBlobBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="{DynamicResource C.Accent.Alpha40}" Offset="0"/>
            <GradientStop Color="{DynamicResource C.Accent.Alpha20}" Offset="0.4"/>
            <GradientStop Color="{DynamicResource C.Accent.Transparent}" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="GlowBlobDangerBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#38FF5B4A" Offset="0"/>
            <GradientStop Color="#18FF5B4A" Offset="0.4"/>
            <GradientStop Color="#00FF5B4A" Offset="1"/>
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="GlowBlobSuccessBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                             RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#3834E0A1" Offset="0"/>
            <GradientStop Color="#1834E0A1" Offset="0.4"/>
            <GradientStop Color="#0034E0A1" Offset="1"/>
        </RadialGradientBrush>

        <!-- ═══════════════════════════════════════════════════════════════
             ANIMATIONS — Keyframes riutilizzabili
             ═══════════════════════════════════════════════════════════════ -->

        <!-- Page entrance: slide up + fade -->
        <Style x:Key="PageEntrance" TargetType="Panel">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.3"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.5">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="30" To="0" Duration="0:0:0.6">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Staggered child entrance -->
        <Style x:Key="StaggerChild" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard BeginTime="0:0:0.15">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.4">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="16" To="0" Duration="0:0:0.45">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pulse glow animation -->
        <Style x:Key="PulseGlow" TargetType="FrameworkElement">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.6" To="1" Duration="0:0:2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Float animation for decorative elements -->
        <Style x:Key="FloatAnim" TargetType="FrameworkElement">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="0" To="-8" Duration="0:0:3.5">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             TYPOGRAPHY
             ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="38"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="30"/>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             BUTTONS
             ═══════════════════════════════════════════════════════════════ -->

        <!-- Primary CTA button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#031018"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="32,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource AccentGradient}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="{DynamicResource C.Accent}" BlurRadius="0"
                                                  ShadowDepth="0" Opacity="0.9"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="28" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.04" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.04" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource DangerGradient}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="#FF5B4A" BlurRadius="0"
                                                  ShadowDepth="0" Opacity="0.85"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="24" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.04" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.04" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2744"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.02" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="sc"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#233050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window chrome buttons -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinBtn" TargetType="Button" BasedOn="{StaticResource CloseBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2A4A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════
             CARDS & CONTROLS
             ═══════════════════════════════════════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGradient}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeGradient}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Color="#000510" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1A30"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentSelectionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource C.Accent}" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="24" Height="24" CornerRadius="8"
                                    Background="#0D1A30"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="check" Stretch="Uniform" Width="13" Height="13"
                                      Stroke="#031018" StrokeThickness="2.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Opacity="0"
                                      Data="M2,6 L5,9 L10,2"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentGradient}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="check" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="box" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource C.Accent}" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{StaticResource ProgressTrackGradient}"
                                    CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{DynamicResource ProgressFillGradient}"
                                    CornerRadius="6" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource C.Accent}" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                                <Rectangle x:Name="shine" Width="80" HorizontalAlignment="Left">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#AAFFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="shineT" X="-80"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="shineT"
                                                         Storyboard.TargetProperty="X"
                                                         From="-80" To="600" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

