<Window x:Class="VoltManager.Setup.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoltManager Setup"
        Width="640" Height="500"
        MinWidth="640" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True">

    <Border Background="{DynamicResource WindowBgGradient}" CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="Black" Opacity="0.7"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Ambient accent glow (behind content) ─────────── -->
            <Border Grid.Column="1" CornerRadius="0,12,12,0" ClipToBounds="True" IsHitTestVisible="False">
                <Canvas>
                    <Ellipse Width="320" Height="320" Canvas.Right="-120" Canvas.Top="-150"
                             Fill="{DynamicResource GlowBlobBrush}" Opacity="0.7"/>
                    <Ellipse Width="260" Height="260" Canvas.Left="-90" Canvas.Bottom="-130"
                             Fill="{DynamicResource GlowBlobBrush}" Opacity="0.5"/>
                </Canvas>
            </Border>

            <!-- ── Left sidebar ─────────────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}" CornerRadius="12,0,0,12"
                    BorderBrush="#14213F" BorderThickness="0,0,1,0">
                <Grid Margin="0,28,0,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo + title -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,32">
                        <Grid Width="74" Height="74" HorizontalAlignment="Center">
                            <Ellipse x:Name="LogoRing" Width="74" Height="74" Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="1.4" Opacity="0.55">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00F1FE" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="LogoBrush" Stretch="Uniform"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="LogoRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.4" To="0.85" Duration="0:0:1.8">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>
                        <TextBlock Text="VoltManager" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock x:Name="VersionText" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Step indicators -->
                    <StackPanel Grid.Row="1" Margin="20,0" x:Name="StepPanel"/>

                    <!-- Footer brand -->
                    <TextBlock Grid.Row="2" Text="Albix4563" FontSize="10"
                               Foreground="{DynamicResource BorderBrush2}" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Right content ────────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>  <!-- custom titlebar -->
                    <RowDefinition Height="*"/>   <!-- page content -->
                    <RowDefinition Height="64"/>  <!-- footer buttons -->
                </Grid.RowDefinitions>

                <!-- Titlebar (drag area + close) -->
                <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}"
                            HorizontalAlignment="Right" Margin="0,2,6,0"
                            Content="✕" Click="BtnClose_Click"/>
                </Grid>

                <!-- Page host -->
                <ContentControl Grid.Row="1" x:Name="PageHost" Margin="32,0,32,0"/>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                        Padding="28,0">
                    <Grid>
                        <Button x:Name="BtnBack" Style="{StaticResource GhostBtn}"
                                HorizontalAlignment="Left" Visibility="Collapsed"
                                Click="BtnBack_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                            <Button x:Name="BtnCancel" Style="{StaticResource GhostBtn}"
                                    Margin="0,0,8,0" Click="BtnCancel_Click"/>
                            <Button x:Name="BtnNext" Style="{StaticResource PrimaryBtn}"
                                    Click="BtnNext_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
