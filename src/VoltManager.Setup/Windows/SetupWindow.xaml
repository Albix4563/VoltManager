<Window x:Class="VoltManager.Setup.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoltManager Setup"
        Width="760" Height="580"
        MinWidth="760" MinHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="{DynamicResource WindowBgGradient}" CornerRadius="16"
            BorderBrush="#26property" BorderThickness="0">
        <Border CornerRadius="16" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33507FB0" Offset="0"/>
                    <GradientStop Color="#1A2A4A" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="Black" Opacity="0.75"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Ambient accent glow (behind right content) ─────── -->
                <Border Grid.Column="1" CornerRadius="0,16,16,0" ClipToBounds="True" IsHitTestVisible="False">
                    <Canvas>
                        <Ellipse Width="380" Height="380" Canvas.Right="-150" Canvas.Top="-180"
                                 Fill="{DynamicResource GlowBlobBrush}" Opacity="0.75"/>
                        <Ellipse Width="300" Height="300" Canvas.Left="-110" Canvas.Bottom="-150"
                                 Fill="{DynamicResource GlowBlobBrush}" Opacity="0.5"/>
                    </Canvas>
                </Border>

                <!-- ══════════════ LEFT SIDEBAR ══════════════ -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}" CornerRadius="16,0,0,16"
                        BorderBrush="#16223F" BorderThickness="0,0,1,0">
                    <Grid Margin="0,34,0,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo + title -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,34">
                            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                <Ellipse Width="84" Height="84" Fill="{DynamicResource GlowBlobBrush}" Opacity="0.8"/>
                                <Ellipse x:Name="LogoRing" Width="78" Height="78" Stroke="{DynamicResource AccentBrush}"
                                         StrokeThickness="1.4" Opacity="0.55">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#00F1FE" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="62" Height="62" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="LogoBrush" Stretch="Uniform"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="LogoRing"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 From="0.4" To="0.9" Duration="0:0:1.9">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                            </Grid>
                            <TextBlock Text="VoltManager" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                            <TextBlock x:Name="VersionText" FontSize="11"
                                       Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Step indicators (built in code-behind) -->
                        <StackPanel Grid.Row="1" Margin="26,0" x:Name="StepPanel"/>

                        <!-- Footer brand -->
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                            <Border Width="46" Height="3" CornerRadius="2" Background="#1A2742" Margin="0,0,0,12"/>
                            <TextBlock Text="by Albix4563" FontSize="10.5"
                                       Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════ RIGHT CONTENT ══════════════ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>   <!-- custom titlebar -->
                        <RowDefinition Height="*"/>    <!-- page content -->
                        <RowDefinition Height="72"/>   <!-- footer buttons -->
                    </Grid.RowDefinitions>

                    <!-- Titlebar (drag area + window buttons) -->
                    <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock x:Name="HeaderText" VerticalAlignment="Center" Margin="32,0,0,0"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FaintBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,8,0">
                            <Button x:Name="BtnMin" Style="{StaticResource MinBtn}"
                                    Content="—" FontSize="12" Click="BtnMin_Click"/>
                            <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}"
                                    Content="✕" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Page host (vertically centered) -->
                    <ContentControl Grid.Row="1" x:Name="PageHost" Margin="40,4,40,4"
                                    VerticalContentAlignment="Center"/>

                    <!-- Footer -->
                    <Border Grid.Row="2" BorderBrush="#1E2C4C" BorderThickness="0,1,0,0" Padding="34,0">
                        <Grid>
                            <Button x:Name="BtnBack" Style="{StaticResource GhostBtn}"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Click="BtnBack_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                                <Button x:Name="BtnCancel" Style="{StaticResource GhostBtn}"
                                        Margin="0,0,10,0" Click="BtnCancel_Click"/>
                                <Button x:Name="BtnNext" Style="{StaticResource PrimaryBtn}"
                                        Click="BtnNext_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Border>
</Window>
