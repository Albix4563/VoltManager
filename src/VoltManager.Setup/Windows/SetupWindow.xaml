<Window x:Class="VoltManager.Setup.Windows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoltManager Setup"
        Width="800" Height="600"
        MinWidth="800" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Background="{StaticResource WindowBgGradient}" CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">

        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarGradient}"
                    CornerRadius="14,0,0,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="24,26,20,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,30">
                        <Grid Width="48" Height="48" HorizontalAlignment="Left">
                            <Ellipse Width="48" Height="48" Fill="{StaticResource InsetBrush}"
                                     Stroke="{StaticResource BorderLightBrush}" StrokeThickness="1"/>
                            <Ellipse Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     RenderOptions.BitmapScalingMode="HighQuality">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="LogoBrush" Stretch="Uniform"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="VoltManager" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,0"/>
                        <TextBlock x:Name="VersionText" FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" x:Name="StepPanel" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="68"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock x:Name="HeaderText" VerticalAlignment="Center" Margin="36,0,0,0"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,10,0">
                        <Button x:Name="BtnMin" Style="{StaticResource MinBtn}" Content="—"
                                Click="BtnMin_Click"/>
                        <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Content="✕"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>

                <ContentControl Grid.Row="1" x:Name="PageHost" Margin="36,4,36,8"
                                VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"/>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="36,0">
                    <Grid>
                        <Button x:Name="BtnBack" Style="{StaticResource GhostBtn}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"
                                Click="BtnBack_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnCancel" Style="{StaticResource GhostBtn}"
                                    Margin="0,0,10,0" Click="BtnCancel_Click"/>
                            <Button x:Name="BtnNext" Style="{StaticResource PrimaryBtn}"
                                    Click="BtnNext_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
